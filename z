.hero-video{
 position: relative;
 height: 100vh;
 overflow: hidden;
 background-color: black;
}
.bg-video{
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    filter: brightness(0.5) ;
}
.hero-content{
    position: relative;
    z-index: 2;
    text-align: center;
    top: 50%;
    color: white;
    padding: 0 1rem;

}
h1{
    font-family: "VT323", monospace;
    font-weight: 800;
}
h2{
    font-family: "VT323", monospace;
    font-weight: 200;
}
section{
    padding: 20px;
}
.section-title{
    font-size: 2.5 rem;
    margin-bottom: 40px;
    color: chartreuse;
    text-align: center;
    font-family: "vt323", monospace;
}
.card-body{
    background-color: gray;
}
.nav-link:hover{
    color: chartreuse;
}
.cardResena{
